# Copy this file to .env and fill in real values. .env is gitignored
# (see .gitignore's "--- Env / secrets ---" section) -- never commit
# real credentials.

# Postgres connection string. api/database.py rewrites the
# postgresql:// scheme to the async-capable psycopg (v3) driver
# automatically -- just provide a normal connection string here.
DATABASE_URL=postgresql://user:password@host/dbname

# development | staging | production -- not yet read by any code path,
# reserved for environment-specific config as the API grows.
ENVIRONMENT=development
