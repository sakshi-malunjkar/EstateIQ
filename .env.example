# Copy this file to .env and fill in real values. .env is gitignored
# (see .gitignore's "--- Env / secrets ---" section) -- never commit
# real credentials.

# Postgres connection string. api/database.py rewrites the
# postgresql:// scheme to the async-capable psycopg (v3) driver
# automatically -- just provide a normal connection string here.
DATABASE_URL=postgresql://user:password@host/dbname

# development | staging | production -- not yet read by any code path,
# reserved for environment-specific config as the API grows.
ENVIRONMENT=development

# Supabase Auth (Project Settings -> API). Only the URL and anon key are used
# server-side; the service_role key is intentionally NOT needed.
SUPABASE_URL=https://peopvbmhclfcqbzbtjkf.supabase.co
SUPABASE_ANON_KEY=

# Hugging Face model repo holding models_artifacts/: the API downloads any model
# folders missing on disk at startup. HF_TOKEN is only needed if the repo is private.
HF_TOKEN=
HF_REPO_ID=EstateIQ/estateiq-models
